# Shared storage. For an offline local preview only, choose file.
ROAST_STORAGE=mongodb
# Generate a unique password at least 24 characters long. Never use NEXT_PUBLIC_.
ROAST_ADMIN_PASSWORD=
# Optional local file override (default: .data/roasts.json)
# ROAST_DATA_FILE=

# Configure before publishing a shared wall. Never commit real credentials.
ROAST_MONGODB_URI=
ROAST_MONGODB_DB=whiff_web
# Only set to an IP header overwritten by your hosting provider's trusted proxy.
# With no trusted header configured, requests share one conservative rate bucket.
# ROAST_IP_HEADER=
