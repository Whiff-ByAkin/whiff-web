# Shared storage. For an offline local preview only, choose file.
ROAST_STORAGE=mongodb
# Generate a unique password at least 24 characters long. Never use NEXT_PUBLIC_.
ROAST_ADMIN_PASSWORD=
# Optional local file override (default: .data/roasts.json)
# ROAST_DATA_FILE=

# Configure before publishing a shared wall. Never commit real credentials.
ROAST_MONGODB_URI=
ROAST_MONGODB_DB=whiff_web
# Only set to an IP header overwritten by your hosting provider's trusted proxy.
# With no trusted header configured, requests share one conservative rate bucket.
# ROAST_IP_HEADER=

# Public routes are fixed: original at /, Minnesota at /mn.
# HOME_VARIANT is retired and does not affect either page.
# Production owner password: generate at least 32 random characters.
HOME_ADMIN_PASSWORD=
# Optional shared storage for owner login rate limits.
# Public page routing does not require a database.
HOME_SETTINGS_MONGODB_URI=
HOME_SETTINGS_MONGODB_DB=whiff_web
# Only a header overwritten by your hosting provider's trusted proxy.
# HOME_ADMIN_IP_HEADER=
# Local development only; both are ignored by production builds.
# HOME_SETTINGS_STORAGE=file
# HOME_SETTINGS_FILE=
# HOME_LOCAL_OWNER=1
